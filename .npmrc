# Pacotes de plugin (@venore/plugin-*) entram como dependency file:../venore-plugin-<key>
# no dev local. install-links copia em vez de symlinkar -> o pacote resolve react/@venore/plugin-sdk
# subindo pro node_modules do host (symlink resolveria a partir do path real, fora da árvore).
# Num registry de verdade (Vercel) isso é irrelevante — npm já instala como dir real.
install-links=true
